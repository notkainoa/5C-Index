{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"organizeImports": { "enabled": true },
	"linter": {
		"enabled": true,
		"rules": { "recommended": true }
	},
	"formatter": { "enabled": true },
	"files": { "ignore": ["dist", "**/dist/**", "node_modules"] },
	"overrides": [
		{
			"include": ["**/test/**"],
			"linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
		}
	]
}
