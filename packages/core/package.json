{
	"name": "5c-core",
	"version": "0.4.1",
	"private": true,
	"description": "5C Index core — fetch, cache, normalize, search, conflicts. Zero Node APIs in logic (fetch/fs injected).",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsup src/index.ts --format esm --dts --out-dir dist",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"eval": "tsx scripts/eval.ts"
	},
	"dependencies": {
		"minisearch": "7.2.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"tsup": "8.3.5",
		"tsx": "4.19.2",
		"typescript": "5.6.3",
		"vitest": "2.1.8"
	}
}
