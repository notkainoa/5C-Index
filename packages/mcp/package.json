{
	"name": "5c-mcp",
	"version": "0.4.0",
	"description": "5C Index MCP server — 5 tools over the shared 5c-core engine.",
	"type": "module",
	"license": "MIT",
	"author": "notkainoa <hi@kainoa.me>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/notkainoa/5C-Index.git",
		"directory": "packages/mcp"
	},
	"bugs": "https://github.com/notkainoa/5C-Index/issues",
	"homepage": "https://github.com/notkainoa/5C-Index#readme",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"5c",
		"claremont-colleges",
		"course-search"
	],
	"bin": {
		"5c-mcp": "./dist/server.js"
	},
	"files": ["dist"],
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"start": "node ./dist/server.js",
		"start:http": "node ./dist/server.js --http --port 3000"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.30.1",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"5c-core": "workspace:*",
		"@types/node": "22.10.2",
		"tsup": "8.3.5",
		"typescript": "5.6.3",
		"vitest": "2.1.8"
	}
}
