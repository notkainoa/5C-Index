{
	"name": "5c-mcp",
	"version": "0.1.0",
	"description": "5C Index MCP server \u2014 5 tools over the shared 5c-core engine.",
	"type": "module",
	"bin": {
		"5c-mcp": "./dist/server.js"
	},
	"files": ["dist"],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"start": "node ./dist/server.js",
		"start:http": "node ./dist/server.js --http --port 3000"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.30.1",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"5c-core": "workspace:*",
		"@types/node": "22.10.2",
		"tsup": "8.3.5",
		"typescript": "5.6.3",
		"vitest": "2.1.8"
	}
}
