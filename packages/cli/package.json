{
	"name": "5c-cli",
	"version": "0.4.0",
	"description": "5c — agent-first CLI for Claremont Colleges (5C) course search.",
	"type": "module",
	"license": "MIT",
	"author": "notkainoa <hi@kainoa.me>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/notkainoa/5C-Index.git",
		"directory": "packages/cli"
	},
	"bugs": "https://github.com/notkainoa/5C-Index/issues",
	"homepage": "https://github.com/notkainoa/5C-Index#readme",
	"keywords": [
